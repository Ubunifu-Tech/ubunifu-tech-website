# ── Database ────────────────────────────────────────────────────────────────
# Postgres 18. Local dev uses the Postgres.app socket as the OS user.
DATABASE_URL="postgresql://USER@localhost:5432/ubunifu_console_dev?schema=public"

# ── Email (already used by the public contact form) ─────────────────────────
RESEND_API_KEY=""

# ── Console ─────────────────────────────────────────────────────────────────
# Secret used to sign session and magic-link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONSOLE_SESSION_SECRET=""
# Host that serves the staff console. Admin routes are refused on any other host.
CONSOLE_ADMIN_HOST="admin.ubunifutech.com"
# Public origin used to build secure links in emails.
CONSOLE_PUBLIC_ORIGIN="https://ubunifutech.com"

# ── AI copilot (contract and update drafting) ───────────────────────────────
ANTHROPIC_API_KEY=""
