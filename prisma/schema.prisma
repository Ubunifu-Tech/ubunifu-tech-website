// Ubunifu Console — client journey, delivery, billing, documents, support, CMS.
//
// MODELLING RULES, so later additions stay consistent:
//
// 1. MONEY is always an integer in the currency's minor unit (cents, senti) plus
//    an ISO-4217 code. Never a float. A USD 75.00 deposit is amountMinor 7500,
//    currency "USD". Mixed-currency work is normal here: proposals quote USD,
//    Sifa customers think in TZS.
//
// 2. PROJECT STATUS is a delivery state machine only. Money state lives on
//    invoices and payments. A transition that depends on money (you cannot start
//    build before the deposit clears) is enforced as a guard in application code,
//    not by folding payment states into this enum — otherwise every new billing
//    arrangement forces a new project state.
//
// 3. ACTORS are polymorphic by (actorType, actorId) rather than by nullable
//    foreign keys to every table. Staff, client contacts and the system itself
//    all write audit events and messages.
//
// 4. TEMPLATES exist because the six service lines have genuinely different
//    shapes. A branding engagement has no launch; hosting has no build phase;
//    advisory ends in a report. Seeding a project from a template gives each
//    line its own default plan without hard-coding a website workflow.
//
// 5. SOFT DELETE (deletedAt) on records a client may have seen. Hard deletes
//    break audit trails and receipts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer takes the connection URL here — it lives in
// prisma.config.ts for the CLI, and reaches the client through a driver adapter.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and access
// ─────────────────────────────────────────────────────────────────────────────

enum StaffRole {
  owner // full access, including billing and staff management
  admin // full delivery access, no staff management
  member // assigned work only
}

model StaffUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      StaffRole @default(member)
  /// What they do here, shown beside their name: "Designer", "Developer".
  title     String?
  isActive  Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownedProjects   Project[]        @relation("ProjectOwner")
  documentVersions DocumentVersion[]
  payments        Payment[]
  timeEntries     TimeEntry[]
  posts           Post[]
  mediaAssets     MediaAsset[]
  assignedTasks   Deliverable[]    @relation("DeliverableAssignee")

  @@index([isActive])
}

/// The client organisation. A person is a ClientContact; billing and projects
/// hang off the organisation so a change of contact does not orphan history.
model Client {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  legalName    String?
  country      String    @default("TZ")
  /// Default currency for this client's invoices. Overridable per invoice.
  currency     String    @default("USD")
  website      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  contacts        ClientContact[]
  projects        Project[]
  invoices        Invoice[]
  tickets         Ticket[]
  managedServices ManagedService[]
  enquiries       Enquiry[]
  conversations   Conversation[]

  @@index([deletedAt])
}

model ClientContact {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email     String
  name      String
  role      String?
  phone     String?
  /// The contact who signs and receives billing by default.
  isPrimary Boolean   @default(false)
  /// Portal access can be revoked without deleting the person's history.
  canSignIn Boolean   @default(true)
  /// Set when the contact completes account creation from their first magic
  /// link. Until then they can follow secure links but have no password.
  activatedAt   DateTime?
  /// scrypt, salt embedded. Null means the account is invite-only so far.
  passwordHash  String?
  passwordSetAt DateTime?
  /// Throttles credential stuffing without locking anyone out permanently;
  /// the magic-link route stays open as the recovery path.
  failedSignIns Int       @default(0)
  lockedUntil   DateTime?
  lastSeenAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  signatures   Signature[]
  ticketsOpened Ticket[]
  documentResponses SignatureRequest[]
  assignedRequests  AssetRequest[] @relation("AssetRequestAssignee")

  @@unique([clientId, email])
  @@index([email])
}

enum ActorType {
  staff
  client_contact
  system
}

/// Issued to both staff and client contacts. Only the hash is stored, so a
/// leaked database row cannot be replayed as a session.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  actorType    ActorType
  actorId      String
  /// Which host the session was issued for. An admin-console session must not
  /// be replayable against the client portal, or the other way round.
  audience     String
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([actorType, actorId])
  @@index([expiresAt])
}

enum MagicTokenPurpose {
  sign_in
  /// An invitation to a contact who has not set a password yet. Its own
  /// purpose because it has its own lifetime: the email promises 14 days, and
  /// a sign-in link lives 20 minutes.
  invite
  document_access
  invoice_access
  update_access
}

/// Single-use, short-lived, hashed. Covers both passwordless sign-in and the
/// "secure link" emails for documents, invoices and progress updates.
model MagicToken {
  id         String            @id @default(cuid())
  tokenHash  String            @unique
  purpose    MagicTokenPurpose
  actorType  ActorType
  actorId    String
  /// Optional target the link grants access to (a document, invoice, update).
  entityType String?
  entityId   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())
  ip         String?

  @@index([actorType, actorId])
  @@index([expiresAt])
}

/// Append-only. Never updated, never deleted.
model AuditEvent {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enquiries — the front door, fed by the marketing site's contact form
// ─────────────────────────────────────────────────────────────────────────────

enum EnquiryStatus {
  new
  triaged
  in_conversation
  qualified
  converted
  declined
  spam
}

/// Written by POST /api/contact. Every message the public form accepts lands
/// here first, whether or not it ever becomes a project.
model Enquiry {
  id          String        @id @default(cuid())
  /// Matches the allowlist in the contact route, e.g. "Project enquiry".
  subject     String
  name        String
  email       String
  message     String
  status      EnquiryStatus @default(new)
  /// Best guess at the service line, set on triage.
  serviceLine ServiceLine?
  source      String        @default("website_contact_form")
  /// Set once the enquiry becomes a real client.
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  internalNote String?
  submissionId String?      @unique
  ip          String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  conversations Conversation[]

  @@index([status])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects and delivery
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors src/content/services.tsx. Keep the two in step.
enum ServiceLine {
  web // Websites & Custom Platforms
  hosting // Hosting, Domains & Email
  branding // Brand Identity & Design
  data // Data & Business Intelligence
  ai // AI & Automation
  strategy // Technology Strategy & Advisory
  product // Insight / Sifa / Rafiki subscriptions
  other
}

/// How the work is shaped and billed, which is independent of the service line.
/// A branding job can be fixed-price; hosting is a retainer; Insight is usage.
enum EngagementType {
  fixed_price_project
  retainer
  subscription
  advisory
  support_only
}

enum ProjectStatus {
  lead
  proposal_draft
  proposal_sent
  proposal_accepted
  contract_sent
  contract_signed
  in_progress
  client_review
  launch_ready
  launched
  handover
  closed
  on_hold
  cancelled
}

model Project {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  slug           String         @unique
  reference      String         @unique
  serviceLine    ServiceLine
  engagementType EngagementType @default(fixed_price_project)
  status         ProjectStatus  @default(lead)
  summary        String?
  currency       String         @default("USD")
  startDate      DateTime?
  targetDate     DateTime?
  launchedAt     DateTime?
  closedAt       DateTime?
  ownerId        String?
  owner          StaffUser?     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  phases          ProjectPhase[]
  assetRequests   AssetRequest[]
  updates         ProjectUpdate[]
  lineItems       LineItem[]
  invoices        Invoice[]
  documents       Document[]
  tickets         Ticket[]
  brandKit        BrandKit?
  managedServices ManagedService[]
  statusEvents    ProjectStatusEvent[]
  timeEntries     TimeEntry[]
  enquiries       Enquiry[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

/// Every status change, with who and why. The project's current status is the
/// latest of these; the column on Project is the denormalised read.
model ProjectStatusEvent {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from      ProjectStatus?
  to        ProjectStatus
  actorType ActorType
  actorId   String?
  note      String?
  createdAt DateTime      @default(now())

  @@index([projectId, createdAt])
}

enum PhaseStatus {
  not_started
  in_progress
  blocked
  client_review
  complete
}

model ProjectPhase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  position  Int
  status    PhaseStatus @default(not_started)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  deliverables Deliverable[]
  updates      ProjectUpdate[]

  @@unique([projectId, position])
  @@index([projectId])
}

model Deliverable {
  id          String    @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  detail      String?
  position    Int
  isComplete  Boolean   @default(false)
  completedAt DateTime?
  /// Shown to the client in the portal. Internal engineering tasks are not.
  isClientVisible Boolean @default(true)
  /// Who on our side is doing it.
  assigneeId  String?
  assignee    StaffUser? @relation("DeliverableAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phaseId])
  @@index([assigneeId])
}

enum AssetRequestStatus {
  requested
  received
  waived
  blocked
}

/// The "what we need from you" checklist. On the Nifuate proposal this is the
/// logo, founder bio, mission/vision/values, tour packages, media and contacts.
/// Clients fulfil these from the portal, which is why it is a first-class model
/// rather than a line in a document.
model AssetRequest {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  detail      String?
  category    String?
  status      AssetRequestStatus @default(requested)
  position    Int
  dueAt       DateTime?
  receivedAt  DateTime?
  /// Who at the client is sending it. Set by staff or by the client.
  assigneeId  String?
  assignee    ClientContact?     @relation("AssetRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  uploads FileUpload[]

  @@index([projectId, status])
  @@index([assigneeId])
}

enum UpdateStatus {
  draft
  published
}

/// The Weekly Update. Publishing one is what the client sees change in the
/// portal, and what triggers their notification email.
model ProjectUpdate {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId     String?
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title       String
  bodyMarkdown String
  status      UpdateStatus @default(draft)
  /// A staging link, preview URL or anything the client should open.
  previewUrl  String?
  publishedAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  uploads FileUpload[]

  @@index([projectId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Brand kit — carried by branding and web work, per the proposal's section 2
// ─────────────────────────────────────────────────────────────────────────────

model BrandKit {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  typography String?
  principles String?
  imageryDirection String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  colors BrandColor[]
}

model BrandColor {
  id       String   @id @default(cuid())
  kitId    String
  kit      BrandKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  name     String
  hex      String
  usage    String?
  position Int

  @@index([kitId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Money
// ─────────────────────────────────────────────────────────────────────────────

/// How a line is charged. The Nifuate proposal alone needs one-off ($15 domain),
/// a 50/50 split ($75 + $75) and annual recurring ($60 hosting, $20/yr support).
enum BillingKind {
  one_off
  installment
  recurring_monthly
  recurring_annual
  usage
}

/// A line can be agreed but not active. The proposal carries a "Deferred"
/// professional-email line and a "Paused" contact-form line, and both must
/// survive in the record without being billed.
enum LineItemStatus {
  planned
  active
  deferred
  paused
  waived
  cancelled
}

model LineItem {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  description String?
  billingKind BillingKind    @default(one_off)
  status      LineItemStatus @default(planned)
  amountMinor Int
  currency    String         @default("USD")
  quantity    Int            @default(1)
  /// Plain-language terms, e.g. "50% deposit due at kick-off".
  terms       String?
  position    Int
  /// ── Recurrence, for recurring_monthly and recurring_annual lines ───────
  /// Billing lives here; the thing being billed lives on ManagedService, since
  /// a domain's expiry date and its invoice date are not always the same day.
  intervalMonths  Int?
  nextDueAt       DateTime?
  /// How far ahead of nextDueAt a draft invoice is raised.
  renewalLeadDays Int            @default(30)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invoiceLines InvoiceLine[]
  managedService ManagedService?
  renewals     RenewalEvent[]

  @@index([projectId, status])
  @@index([nextDueAt])
}

enum RenewalStatus {
  pending
  drafted
  invoiced
  paid
  skipped
  cancelled
}

/// One occurrence of a recurring charge.
///
/// Renewals draft an invoice and raise an alert; nothing is sent to a client
/// without someone looking at it first. This row is also what stops a scheduler
/// from drafting the same period twice, which is why the period is unique per
/// line rather than being inferred from dates at run time.
model RenewalEvent {
  id          String        @id @default(cuid())
  lineItemId  String
  lineItem    LineItem      @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  dueAt       DateTime
  status      RenewalStatus @default(pending)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  draftedAt   DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([lineItemId, periodStart])
  @@index([status, dueAt])
}

enum InvoiceStatus {
  draft
  sent
  part_paid
  paid
  overdue
  void
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status       InvoiceStatus @default(draft)
  currency     String        @default("USD")
  /// Denormalised from the lines so listing screens do not need a join.
  subtotalMinor Int          @default(0)
  taxMinor     Int           @default(0)
  totalMinor   Int           @default(0)
  paidMinor    Int           @default(0)
  notes        String?
  issuedAt     DateTime?
  dueAt        DateTime?
  paidAt       DateTime?
  voidedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
  renewals RenewalEvent[]

  @@index([clientId, status])
  @@index([projectId])
}

model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Kept as a snapshot: editing the project line later must not rewrite an
  /// invoice that has already been sent.
  lineItemId  String?
  lineItem    LineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  label       String
  description String?
  amountMinor Int
  quantity    Int       @default(1)
  position    Int

  @@index([invoiceId])
}

/// Mobile money and bank transfer matter more than cards for Tanzanian clients,
/// so payments are recorded rather than processed. A gateway can later write
/// these same rows.
enum PaymentMethod {
  bank_transfer
  mobile_money
  cash
  card
  other
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountMinor  Int
  currency     String        @default("USD")
  method       PaymentMethod @default(bank_transfer)
  /// Bank reference, mobile-money transaction id, or similar.
  reference    String?
  receivedAt   DateTime
  recordedById String?
  recordedBy   StaffUser?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime      @default(now())

  receipt Receipt?

  @@index([invoiceId])
}

model Receipt {
  id        String   @id @default(cuid())
  number    String   @unique
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  /// Storage key for the rendered PDF, once generated.
  pdfKey    String?
  createdAt DateTime @default(now())
}

/// Domains, hosting plans, mailboxes and maintenance cover — things with a
/// renewal date that someone has to chase. This is the difference between a
/// project tracker and something that can actually run a hosting business.
enum ManagedServiceKind {
  domain
  hosting
  email
  ssl
  maintenance
  other
}

model ManagedService {
  id         String             @id @default(cuid())
  clientId   String
  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// The line that bills this renewal, when there is one.
  lineItemId String?            @unique
  lineItem   LineItem?          @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  kind       ManagedServiceKind
  label      String
  /// Domain name, hostname or mailbox, depending on kind.
  identifier String?
  provider   String?
  isActive   Boolean            @default(true)
  autoRenew  Boolean            @default(false)
  startsAt   DateTime?
  renewsAt   DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([clientId])
  @@index([renewsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Documents, contracts and signatures
// ─────────────────────────────────────────────────────────────────────────────

enum DocumentKind {
  proposal
  contract
  change_order
  statement_of_work
  handover
  other
}

enum DocumentStatus {
  draft
  internal_review
  sent
  viewed
  changes_requested
  signed
  declined
  expired
  superseded
}

model Document {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      DocumentKind
  title     String
  status    DocumentStatus @default(draft)
  reference String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  versions          DocumentVersion[]
  signatureRequests SignatureRequest[]
  conversations     Conversation[]

  @@index([projectId, kind])
}

/// Every revision is kept. AI drafts a version; a human edits it into the next
/// one; the client requests changes and another follows. Nothing is overwritten,
/// so "back and forth until final agreement" is reconstructable afterwards.
model DocumentVersion {
  id              String    @id @default(cuid())
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         Int
  /// Exactly what the client reads and signs. Rendered, hashed, never edited
  /// once a signature request points at it.
  bodyMarkdown    String
  /// What the author wrote, when it differs from bodyMarkdown. A sent version
  /// has its {{fees}} placeholder filled in from the project's fees; keeping
  /// the source separately lets the next edit start from the placeholder, so
  /// the fee schedule is regenerated rather than duplicated.
  sourceMarkdown  String?
  changeNote      String?
  /// True when a model drafted this revision. A human still has to accept it,
  /// so this records provenance rather than authorship.
  aiAssisted      Boolean   @default(false)
  aiModel         String?
  aiPromptSummary String?
  createdById     String?
  createdBy       StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  signatureRequests SignatureRequest[]

  @@unique([documentId, version])
  @@index([documentId])
}

enum SignatureRequestStatus {
  draft
  sent
  viewed
  signed
  declined
  expired
  cancelled
}

model SignatureRequest {
  id         String                 @id @default(cuid())
  documentId String
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Pinned to the exact revision sent. A later edit cannot change what was signed.
  versionId  String
  version    DocumentVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  status     SignatureRequestStatus @default(draft)
  /// SHA-256 of the rendered document at send time, sealed into the audit trail.
  documentHash String
  /// The terms in force when this was sent. Pinned, so republishing the
  /// standard terms cannot change what this request asked someone to accept.
  termsVersionId String?
  termsVersion   TermsVersion? @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  tokenHash  String?                @unique
  sentAt     DateTime?
  viewedAt   DateTime?
  expiresAt  DateTime?
  /// What the client said when they did not sign. Recorded on the request
  /// rather than on the document, because it is an answer to THIS revision —
  /// a later version gets its own request and its own answer.
  respondedAt   DateTime?
  responseNote  String?
  respondedById String?
  respondedBy   ClientContact? @relation(fields: [respondedById], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  signatures Signature[]

  @@index([documentId])
}

/// The standard terms, maintained once in the admin and versioned.
///
/// A contract references the version in force when it was sent, and the client
/// accepts that version by name. Editing the terms later publishes a new
/// version and never rewrites what somebody already agreed to — which is the
/// whole point of keeping them out of the contract body.
model TermsVersion {
  id            String    @id @default(cuid())
  version       Int       @unique
  title         String
  bodyMarkdown  String
  /// Exactly one row may be current; enforced in application code on publish.
  isCurrent     Boolean   @default(false)
  effectiveFrom DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  signatureRequests SignatureRequest[]
  signatures        Signature[]

  @@index([isCurrent])
}

/// Initials typed by the signer, plus an explicit acceptance of the terms.
/// Deliberately not DocuSign: proportionate to the size of these engagements,
/// and the audit trail is ours rather than a third party's.
enum SignatureMethod {
  initials
  typed
  drawn
}

model Signature {
  id          String           @id @default(cuid())
  requestId   String
  request     SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     ClientContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  signerName  String
  signerEmail String
  method      SignatureMethod  @default(initials)
  /// What the signer actually typed, e.g. "RP". Kept verbatim.
  initials    String?
  /// Data URL of the drawn mark, when method is drawn.
  signatureData String?
  /// Acceptance is separate from the signature itself, so it is answerable
  /// later which version of the terms this person agreed to and when.
  termsVersionId  String?
  termsVersion    TermsVersion? @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  termsAcceptedAt DateTime?
  /// Re-hashed at signing time and compared with the request's hash, so a
  /// mismatch proves the document changed underneath the signer.
  documentHash String
  ip          String?
  userAgent   String?
  signedAt    DateTime         @default(now())

  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Support and change requests
// ─────────────────────────────────────────────────────────────────────────────

enum TicketKind {
  support
  change_request
  bug
  question
  content_update
}

enum TicketStatus {
  open
  triaged
  in_progress
  waiting_on_client
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

model Ticket {
  id          String         @id @default(cuid())
  reference   String         @unique
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  openedById  String?
  openedBy    ClientContact? @relation(fields: [openedById], references: [id], onDelete: SetNull)
  kind        TicketKind     @default(support)
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(normal)
  subject     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  messages      TicketMessage[]
  conversations Conversation[]

  @@index([clientId, status])
  @@index([projectId])
}

model TicketMessage {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorType  ActorType
  actorId    String?
  body       String
  /// Internal notes stay out of the portal.
  isInternal Boolean   @default(false)
  createdAt  DateTime  @default(now())

  uploads FileUpload[]

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Files
// ─────────────────────────────────────────────────────────────────────────────

/// One upload table with optional parents, rather than an attachments table per
/// feature. Storage key points at whatever bucket is configured.
model FileUpload {
  id             String         @id @default(cuid())
  storageKey     String         @unique
  filename       String
  contentType    String
  sizeBytes      Int
  checksum       String?
  uploadedByType ActorType
  uploadedById   String?
  assetRequestId String?
  assetRequest   AssetRequest?  @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)
  updateId       String?
  update         ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  ticketMessageId String?
  ticketMessage  TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  @@index([assetRequestId])
  @@index([updateId])
  @@index([ticketMessageId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound email
// ─────────────────────────────────────────────────────────────────────────────

enum EmailStatus {
  queued
  sent
  failed
}

/// Every message the system sends, so "did the client get the link" is
/// answerable without opening the Resend dashboard.
model EmailLog {
  id         String      @id @default(cuid())
  toAddress  String
  template   String
  subject    String
  status     EmailStatus @default(queued)
  providerId String?
  error      String?
  entityType String?
  entityId   String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())

  @@index([toAddress])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Effort
// ─────────────────────────────────────────────────────────────────────────────

/// Not billed by the hour today, but knowing what a fixed-price job actually
/// cost is the only way to price the next one honestly.
model TimeEntry {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId    String
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  minutes    Int
  note       String?
  workedOn   DateTime
  createdAt  DateTime  @default(now())

  @@index([projectId, workedOn])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────────────────────────────────────

/// Images for the public website: journal covers, and images inside posts.
///
/// A separate table from FileUpload ON PURPOSE. /media/<id> serves these to
/// anyone, with no session, because a blog image has to load for a stranger
/// reading the blog. A public route that can only ever query this table cannot
/// — by construction, not by a WHERE clause somebody might one day get wrong —
/// hand out a client's contract, invoice or founder bio. Those live in
/// FileUpload and are only ever served behind a session check.
///
/// The bytes are in the same private blob store as everything else; the route
/// is the only door, which is what keeps the address on our own domain.
model MediaAsset {
  id           String     @id @default(cuid())
  storageKey   String     @unique
  /// As the uploader's computer had it. Shown in the console, never in a URL.
  filename     String
  contentType  String
  /// The extension the public URL carries, derived from contentType on the
  /// way in so there is exactly one address per image.
  extension    String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   StaffUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
}

enum PostStatus {
  draft
  scheduled
  published
}

/// The marketing site currently reads _posts/*.md through gray-matter. This
/// model is the destination for that content; the reader can fall back to files
/// until every post is migrated, so the public site never depends on a database
/// that might be down.
model Post {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  excerpt      String
  bodyMarkdown String
  status       PostStatus @default(draft)
  tags         String[]   @default([])
  coverImage   String?
  coverAlt     String?
  authorId     String?
  author       StaffUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// The byline as it appears on the post. Usually the company rather than a
  /// person, and kept separately from authorId so the credit on a published
  /// piece does not change when a staff member leaves.
  authorName   String?
  /// The writer's profile, when the byline is somebody in the writers list.
  /// The byline text above is still what is printed; the profile adds their
  /// role, a short bio and a link under the article.
  writerId     String?
  writer       Writer?    @relation(fields: [writerId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  /// The first time it went live. Set once and never cleared, because from
  /// then on people may have the link, so the address is fixed.
  firstPublishedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([status, publishedAt])
  @@index([writerId])
}

/// Somebody who writes for the journal: a colleague, a guest, a client. Not
/// a console account. How to reach them (email, phone, notes) is for us and
/// never shown; role, bio, link and photo appear with their articles.
model Writer {
  id        String    @id @default(cuid())
  name      String
  /// Shown beside the byline, e.g. "Data lead, Ubunifu Technologies".
  role      String?
  bio       String?
  /// Their own site or profile, https only.
  link      String?
  /// A /media/ path from the console's uploads.
  photo     String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  posts Post[]

  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Templates — so each service line starts from its own sensible plan
// ─────────────────────────────────────────────────────────────────────────────

model ProjectTemplate {
  id          String      @id @default(cuid())
  serviceLine ServiceLine
  name        String
  description String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  phases        PhaseTemplate[]
  assetRequests AssetRequestTemplate[]
  lineItems     LineItemTemplate[]

  @@unique([serviceLine, name])
}

model PhaseTemplate {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  goal       String?
  position   Int
  /// Offsets from project start, so a template can lay out a timeline.
  startDayOffset Int?
  endDayOffset   Int?

  deliverables DeliverableTemplate[]

  @@unique([templateId, position])
}

model DeliverableTemplate {
  id              String        @id @default(cuid())
  phaseTemplateId String
  phaseTemplate   PhaseTemplate @relation(fields: [phaseTemplateId], references: [id], onDelete: Cascade)
  title           String
  detail          String?
  position        Int
  isClientVisible Boolean       @default(true)

  @@unique([phaseTemplateId, position])
}

model AssetRequestTemplate {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  detail     String?
  category   String?
  position   Int

  @@unique([templateId, position])
}

model LineItemTemplate {
  id          String          @id @default(cuid())
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label       String
  description String?
  billingKind BillingKind     @default(one_off)
  /// Suggested amount; always editable when the project is created.
  amountMinor Int             @default(0)
  currency    String          @default("USD")
  terms       String?
  position    Int

  @@unique([templateId, position])
}

/// Who we are on a document, and how to pay us.
///
/// A single row. It exists because an invoice without a registered name and a
/// TIN is not one a Tanzanian client's accountant will accept, and because
/// hardcoding bank details in a component means changing them requires a
/// deploy. Snapshotted onto an invoice when it is sent, so changing the bank
/// account later never rewrites a document somebody is already holding.
model OrgSettings {
  /// Always "default". A constant id is what makes this a singleton without a
  /// separate table of one.
  id String @id @default("default")

  legalName String @default("Ubunifu Technologies")
  tradingName String?
  /// Taxpayer Identification Number. Printed on every invoice.
  tin       String?
  /// VAT Registration Number, where registered.
  vrn       String?
  addressLines String?
  country   String  @default("TZ")
  email     String  @default("info@ubunifutech.com")
  phone     String?
  website   String?

  /// Basis points, so 18% is 1800 and nothing is stored as a float.
  vatRateBps Int     @default(0)
  chargesVat Boolean @default(false)

  bankName        String?
  bankAccountName String?
  bankAccountNumber String?
  bankSwift       String?
  mobileMoneyName String?
  mobileMoneyNumber String?

  /// Printed at the foot of every invoice.
  invoiceFooter String?
  /// Days from issue to due, unless overridden on the invoice.
  paymentTermsDays Int @default(14)

  /// What admins and members may do, as { admin: [...], member: [...] }.
  /// Owners can always do everything, so the team can never be locked out.
  /// Null means the defaults in src/lib/console/permissions.ts.
  rolePermissions Json?

  updatedAt DateTime @updatedAt
}

/// Where a conversation happened, and therefore what it is allowed to do.
enum ConversationKind {
  /// Staff and the model, drafting or revising a document.
  document_draft
  /// An anonymous visitor on the marketing site.
  site_visitor
  /// A signed-in client asking for help in the portal.
  portal_client
}

enum ConversationStatus {
  open
  /// Produced an enquiry or a ticket. The outcome is on the conversation.
  converted
  closed
  abandoned
}

enum MessageRole {
  user
  assistant
  /// The result of a tool the assistant called, kept so a thread can be
  /// replayed exactly as the model saw it.
  tool
}

/// A thread with the model, kept so it can be continued and audited.
///
/// One table for every surface — the drafting copilot, the website assistant
/// and the portal — because they are the same thing underneath: a sequence of
/// turns, a set of tools the surface allows, and a cost. What differs is the
/// kind, which is what decides which tools are on the table.
model Conversation {
  id     String             @id @default(cuid())
  kind   ConversationKind
  status ConversationStatus @default(open)

  /// Who is on the human side, polymorphic like AuditEvent.
  actorType ActorType?
  actorId   String?
  /// An anonymous visitor, keyed by a cookie so a refresh keeps the thread.
  /// Never an identifier we can trace back to a person on its own.
  visitorKey String?

  /// What it is about, when it is about something already on record.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Set when the conversation produced one of these.
  enquiryId String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  title String?

  /// Rolling counters, so a runaway thread can be cut off and a month's spend
  /// answered without counting rows.
  messageCount Int     @default(0)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  model        String?

  ip        String?
  userAgent String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  messages ConversationMessage[]

  @@index([kind, status])
  @@index([visitorKey])
  @@index([documentId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  /// Present when the assistant called a tool, so what it did and what it was
  /// told back are both on the record rather than only its prose about it.
  toolName   String?
  toolUseId  String?
  toolInput  Json?
  toolResult Json?

  model        String?
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// One row per attempt at something worth throttling: a contact form post, a
/// chat hand-off, a sign-in request, an invitation. Counted in the database
/// because an in-memory counter on serverless is the limit multiplied by
/// however many instances are warm. The key is a hash, never a raw address.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([bucket, keyHash, createdAt])
  @@index([createdAt])
}
