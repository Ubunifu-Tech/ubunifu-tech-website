# ─────────────────────────────────────────────────────────────────────────────
# Ubunifu — marketing site and client console
#
# Copy to .env for local development. In production these are set in the Vercel
# project settings (Settings → Environment Variables), NOT committed here.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────
# Postgres 18.
#
# LOCAL: Postgres.app on 5432, connecting as your OS user.
#   DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/ubunifu_console_dev?schema=public"
#
# PRODUCTION (Railway): copy the connection string from the Postgres service's
# Variables tab. Use the PUBLIC url, because Vercel's build container runs the
# migration from outside Railway's private network. Railway requires TLS, and
# the connection limit keeps serverless functions from exhausting the pool.
#   DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require&connection_limit=5"
DATABASE_URL=""

# Only needed if a pooler is ever put in front of Railway. Migrations need a
# direct connection; PgBouncer in transaction mode cannot run DDL. Leave empty
# while DATABASE_URL is already direct.
DIRECT_DATABASE_URL=""


# ── Console security ─────────────────────────────────────────────────────────
# HMAC key for session cookies, magic links and document hashes. No fallback:
# the app refuses to start without it. Use a DIFFERENT value in production than
# in development, and rotating it signs everyone out, which is the point.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONSOLE_SESSION_SECRET=""

# Host that serves the staff console. Admin routes 404 on every other host.
# Local development uses admin.localhost, which resolves to 127.0.0.1 with no
# /etc/hosts entry — so leave this at the production value even locally.
CONSOLE_ADMIN_HOST="admin.ubunifutech.com"

# Origin used to build links in email sent to clients.
CONSOLE_PUBLIC_ORIGIN="https://ubunifutech.com"

# Origin used for staff sign-in links. Derived from CONSOLE_ADMIN_HOST when
# empty; set it explicitly for a preview deployment on a vercel.app URL.
CONSOLE_ADMIN_ORIGIN=""

# Comma-separated addresses allowed to request a staff sign-in link. Checked on
# every request, not only at sign-in, so removing an address takes effect at
# once rather than when a session expires. A row in StaffUser is not enough on
# its own — the address has to be here too.
CONSOLE_STAFF_EMAILS="info@ubunifutech.com"


# ── Email ────────────────────────────────────────────────────────────────────
# Resend. Already used by the public contact form; the console reuses it for
# magic links, signature requests, invoices and progress updates.
# WITHOUT THIS the contact form returns a 503 telling people to email directly,
# and no console email is delivered.
RESEND_API_KEY=""


# ── AI copilot ───────────────────────────────────────────────────────────────
# Anthropic, for drafting contracts and progress updates. Drafting is disabled
# and the editor still works by hand when this is empty.
ANTHROPIC_API_KEY=""
