{
  "name": "ubunifu-tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:typography": "node scripts/check-typography.mjs",
    "check:project-visuals": "node scripts/check-project-visuals.mjs",
    "check:hero-assets": "node scripts/check-hero-assets.mjs",
    "check:product-art": "node scripts/check-product-art.mjs",
    "brand:export": "node scripts/export-brand-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:typography",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:deploy": "node scripts/migrate-deploy.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.80",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "framer-motion": "^12.34.2",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.21",
    "lucide-react": "^0.574.0",
    "next": "^16.3.2",
    "pg": "8.16.3",
    "prisma": "7.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "sharp": "^0.35.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
