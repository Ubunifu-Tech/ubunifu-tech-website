# ─────────────────────────────────────────────────────────────────────────────
# Ubunifu — marketing site and client console
#
# Copy to .env for local development. In production these are set in the Vercel
# project settings (Settings → Environment Variables), NOT committed here.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────
# Postgres 18.
#
# LOCAL: Postgres.app on 5432, connecting as your OS user.
#   DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/ubunifu_console_dev?schema=public"
#
# PRODUCTION (Railway): copy the connection string from the Postgres service's
# Variables tab. Use the PUBLIC url, because Vercel's build container runs the
# migration from outside Railway's private network. Railway requires TLS. The
# pool size comes from DATABASE_POOL_MAX below; a connection_limit in the URL
# does nothing with the driver this app uses.
#   DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"
#
# sslmode=require means what it means in psql: encrypted, certificate not
# checked. Railway signs its database certificate with its own private
# authority, issued for "localhost", so nothing else would connect. See
# src/lib/db-connection.ts for how each sslmode is read.
#
# In Vercel, set this for the Production environment only (untick Preview and
# Development). A preview deployment that can see it reads and writes the live
# database. Preview builds skip migrations unless ALLOW_PREVIEW_MIGRATIONS=1 is
# set for them, which only makes sense with a separate database.
DATABASE_URL=""

# Set to 1 only for a preview environment with its own database, so its builds
# apply migrations there. Never alongside the production DATABASE_URL.
# ALLOW_PREVIEW_MIGRATIONS=""

# Optional. Connections each serverless instance may hold open. Empty means 5.
# Keep it low: every warm instance has its own pool against Railway's
# connection limit.
DATABASE_POOL_MAX=""

# Optional. Railway's root certificate (PEM), so the app also checks it is
# talking to your database and not something in between. With it set,
# sslmode=require connects only to a server whose certificate this authority
# signed. Newlines may be written as \n. To get it, either copy
# /var/lib/postgresql/data/certs/root.crt from the Postgres service's volume,
# or take the last certificate this prints (needs OpenSSL 1.1.1 or later; the
# openssl that comes with macOS is too old, so use Homebrew's):
#   openssl s_client -starttls postgres -connect HOST.proxy.rlwy.net:PORT -showcerts </dev/null
# Railway's certificates last 820 days. It makes new ones only when the
# database starts within 30 days of expiry, or on a new or restored volume.
# So with this set: restart the database in that last month, then copy the new
# root here. Otherwise the app refuses the expired certificate or the new one.
# Leave empty to skip the check. A path in the URL (sslrootcert=) works too,
# for scripts run on your own machine.
DATABASE_CA_CERT=""

# Only needed if a pooler is ever put in front of Railway. Migrations need a
# direct connection; PgBouncer in transaction mode cannot run DDL. Leave empty
# while DATABASE_URL is already direct.
DIRECT_DATABASE_URL=""


# ── Console security ─────────────────────────────────────────────────────────
# HMAC key for sessions (staff and client), every emailed link (sign-in,
# setup, signing and review links) and the hashes the rate limits keep. It is
# not used for document or signature hashes. No fallback: the app refuses to
# start without it. Use a DIFFERENT value in production than in development.
# Rotating it signs everyone out and stops every link already sent; passwords
# keep working.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONSOLE_SESSION_SECRET=""

# Host that serves the staff console. Every other host sends /admin here.
# Local development uses admin.localhost, which resolves to 127.0.0.1 with no
# /etc/hosts entry, so leave this at the production value even locally.
CONSOLE_ADMIN_HOST="admin.ubunifutech.com"

# Origin used to build links in email sent to clients.
CONSOLE_PUBLIC_ORIGIN="https://ubunifutech.com"

# Host that serves the client portal. Every other host sends /portal here, so
# links in emails sent before the portal had its own address keep working.
# Local development uses portal.localhost, which needs no /etc/hosts entry, so
# leave this at the production value even locally.
CONSOLE_PORTAL_HOST="portal.ubunifutech.com"

# Origin used for every link to the portal in email sent to clients. Locally,
# the dev server's address on portal.localhost. In production leave it empty
# (it is derived from CONSOLE_PORTAL_HOST).
CONSOLE_PORTAL_ORIGIN="http://portal.localhost:3001"

# Origin used for staff sign-in links. Locally, use the address the dev server
# prints, on admin.localhost. In production leave it empty (it is derived from
# CONSOLE_ADMIN_HOST), unless this is a preview on a vercel.app URL.
CONSOLE_ADMIN_ORIGIN="http://admin.localhost:3001"

# The company account. Its first sign-in link makes it the console owner, and
# it always passes the address check below. Empty means info@ubunifutech.com.
CONSOLE_OWNER_EMAIL=""

# Comma-separated addresses, or whole domains written as @example.com, that may
# request a staff sign-in link. The person must also be added on the Team page.
# The company account is always allowed. Leave empty to allow any address at
# the company account's domain. Checked on every request, so removing an
# address takes effect at once.
CONSOLE_STAFF_EMAILS=""


# ── Email ────────────────────────────────────────────────────────────────────
# Resend. Already used by the public contact form; the console reuses it for
# magic links, signature requests, invoices and progress updates.
# WITHOUT THIS a contact form message is still saved in the console, but no
# email is sent: not the team notice, not the visitor's confirmation, and no
# console email. In development, sign-in links are printed in the terminal.
RESEND_API_KEY=""


# ── Anthropic ────────────────────────────────────────────────────────────────
# For the website chat, the portal's Help assistant, drafting contracts and
# the console assistant. The model never sends anything and never changes a
# record on its own: the console assistant lays out steps, with prices exactly
# as staff gave them, and a person confirms them. Leave this empty and the
# website chat turns into a message form; everything else still works by hand.
ANTHROPIC_API_KEY=""

# Only for a key that belongs to the organisation rather than to a workspace:
# the API then refuses every request that does not name a workspace. Set the
# workspace's id (wrkspc_..., from console.anthropic.com, Settings, Workspaces).
# A key created inside a workspace needs nothing here.
ANTHROPIC_WORKSPACE_ID=""

# Optional. Defaults to claude-sonnet-5. Set claude-opus-5 for harder drafts.
ANTHROPIC_AGENT_MODEL=""


# ── Hosting links ────────────────────────────────────────────────────────────
# Lets an owner pause and resume a client site's hosting on Vercel from its
# project page, for an invoice that is overdue and that the client has been
# told about. A person presses the button; nothing here runs on its own, and
# the console assistant cannot do it.
#
# The token is made in Vercel under Account Settings, Tokens, scoped to the
# team that holds the client sites. It can pause any project in that team, so
# treat it like a password and set it for Production only.
#
# WITHOUT THIS a Vercel project id can still be saved on a project, unchecked,
# and the Pause and Resume buttons say the token is missing.
VERCEL_ACCESS_TOKEN=""

# The team that owns the client projects (team_..., from the team's Settings
# page on Vercel). Leave empty for projects on a personal account.
VERCEL_TEAM_ID=""

# Nothing to set: Vercel provides VERCEL_PROJECT_ID to this app's own
# deployments. The console refuses to link or pause that project, because
# pausing it would take the console itself down.


# ── Client file uploads ──────────────────────────────────────────────────────
# Vercel Blob. The "what we still need from you" checklist on a project lets a
# client attach the logo, the bio and the photographs to the item they answer,
# instead of sending them to somebody's inbox.
#
# Create the store in the Vercel dashboard (Storage → Create → Blob) and link
# it to this project; Vercel then sets this variable on every deployment on its
# own. To upload from a laptop, copy the same value here.
#
# Blobs are PRIVATE and are never linked to directly. Every read goes through
# /portal/files/<id> (client) or /files/<id> (staff) on our own domain, which
# check the session, check that the file belongs to the reader, and only then
# stream it. A public blob URL would be its own permission: impossible to
# revoke, invisible in any log, and valid for anyone it is forwarded to.
#
# WITHOUT THIS the upload box is not shown and the checklist says to email or
# WhatsApp them over, which still works.
BLOB_READ_WRITE_TOKEN=""

# Set automatically alongside the token when the store is linked to the project.
# The SDK uses it to rebuild an object's address from its pathname, so a stored
# key can never send a fetch to a host we do not own.
BLOB_STORE_ID=""

# Only used by the presigned-upload flow, which this app does not use — client
# uploads go through handleUpload, and that verifies the completion callback
# with an HMAC over the body against BLOB_READ_WRITE_TOKEN. Set it anyway: it
# costs nothing and it is one less thing to discover later.
BLOB_WEBHOOK_PUBLIC_KEY=""
